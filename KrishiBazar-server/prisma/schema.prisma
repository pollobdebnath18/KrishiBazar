
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default (uuid())
  name String 
  email String
  password String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role Role
}

enum Role {
  Admin
  Farmer
  Buyer
}
